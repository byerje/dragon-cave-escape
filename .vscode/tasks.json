{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serve Dragon Cave Escape",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "http.server",
                "5500"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*Serving HTTP.*",
                    "endsPattern": ".*Serving HTTP.*"
                }
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Open Dragon Cave Escape in Browser",
            "type": "shell",
            "command": "Start-Process 'http://localhost:5500/index.html'",
            "dependsOn": "Serve Dragon Cave Escape",
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent"
            }
        }
    ]
}
